/*
 * Daily CVE audit of the company bootstrap parent (child of spring-boot-starter-parent).
 *
 *  1. Checks out the bootstrap from GitLab and computes its effective POM
 *     -> every dependency it manages: its own <dependencyManagement> + everything
 *        inherited from spring-boot-dependencies (imported BOMs are inlined).
 *  2. JFrog Xray  (POST /xray/api/v1/summary/component) -> security issues + fixed versions per GAV.
 *  3. JFrog Catalog (GraphQL)                            -> CVEs, severity, CVSS, known exploit per GAV.
 *  4. Merges both, computes a recommended patched version per dependency,
 *     mails an HTML report (+ CSV attachment) and archives everything.
 *
 * Plugins: Pipeline, Git, Pipeline Utility Steps, Email Extension, Config File Provider,
 *          Credentials Binding, Timestamper.
 * Credentials: 'gitlab-ssh-key' (SSH key), 'jfrog-access-token' (secret text, Xray read).
 * Managed file: 'maven-settings-artifactory' (settings.xml pointing to Artifactory).
 */

pipeline {
    agent { label 'maven' }

    tools {
        maven 'maven-3.9'
        jdk   'jdk-21'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        timeout(time: 60, unit: 'MINUTES')
    }

    triggers {
        // Every day around 06:00 Paris time (H spreads the start inside the hour)
        cron('''TZ=Europe/Paris
H 6 * * *''')
    }

    parameters {
        string(name: 'BOOTSTRAP_REPO',   defaultValue: 'git@gitlab.mycompany.com:platform/company-bootstrap.git', description: 'GitLab repository of the bootstrap parent')
        string(name: 'BOOTSTRAP_BRANCH', defaultValue: 'main', description: 'Branch to analyse')
        string(name: 'MAIL_TO',          defaultValue: 'architects@mycompany.com', description: 'Comma-separated recipients')
        choice(name: 'MIN_SEVERITY',     choices: ['Low', 'Medium', 'High', 'Critical'], description: 'Ignore CVEs below this severity')
        booleanParam(name: 'MAIL_WHEN_CLEAN', defaultValue: true, description: 'Send the mail even when no CVE is found')
    }

    environment {
        JFROG_URL     = 'https://mycompany.jfrog.io'          // platform URL, no trailing slash
        CATALOG_PATH  = '/catalog/api/v1/custom/graphql'
        XRAY_CHUNK    = '100'                                 // components per Xray call
        CATALOG_CHUNK = '25'                                  // packageVersion aliases per GraphQL call
    }

    stages {

        stage('Prepare') {
            steps {
                sh 'rm -rf report tmp && mkdir -p report tmp'
            }
        }

        stage('Checkout bootstrap') {
            steps {
                dir('bootstrap') {
                    git url: params.BOOTSTRAP_REPO, branch: params.BOOTSTRAP_BRANCH, credentialsId: 'gitlab-ssh-key'
                }
            }
        }

        stage('Resolve managed dependencies') {
            steps {
                dir('bootstrap') {
                    configFileProvider([configFile(fileId: 'maven-settings-artifactory', variable: 'MVN_SETTINGS')]) {
                        // -N = root POM only (works even if the bootstrap is multi-module)
                        sh 'mvn -B -N -U -s "$MVN_SETTINGS" help:effective-pom -Doutput=target/effective-pom.xml'
                    }
                }
                script {
                    def model   = readMavenPom file: 'bootstrap/target/effective-pom.xml'
                    def managed = extractManaged(model)
                    env.BOOTSTRAP_GAV = "${model.groupId}:${model.artifactId}:${model.version}"
                    writeJSON file: 'report/managed-dependencies.json', json: managed, pretty: 2
                    echo "${env.BOOTSTRAP_GAV} manages ${managed.size()} dependencies"
                }
            }
        }

        stage('Xray: issues & fixed versions') {
            steps {
                script {
                    def managed = readJSON file: 'report/managed-dependencies.json', returnPojo: true
                    def chunks  = chunk(managed, env.XRAY_CHUNK as int)
                    def xray    = [:]
                    withCredentials([string(credentialsId: 'jfrog-access-token', variable: 'JF_TOKEN')]) {
                        for (int i = 0; i < chunks.size(); i++) {
                            writeJSON file: "tmp/xray-req-${i}.json", json: xrayBody(chunks[i])
                            // single-quoted shell vars: the token is never interpolated by Groovy
                            sh """
                                curl -sS --fail-with-body -X POST \\
                                  -H "Authorization: Bearer \$JF_TOKEN" \\
                                  -H 'Content-Type: application/json' \\
                                  --data @tmp/xray-req-${i}.json \\
                                  -o tmp/xray-resp-${i}.json \\
                                  "\$JFROG_URL/xray/api/v1/summary/component"
                            """
                            mergeXray(xray, readJSON(file: "tmp/xray-resp-${i}.json", returnPojo: true))
                        }
                    }
                    writeJSON file: 'report/xray.json', json: xray, pretty: 2
                    echo "Xray: ${xray.size()} vulnerable components"
                }
            }
        }

        stage('Catalog: CVE details') {
            steps {
                // Catalog is an enrichment: if it fails the report is still sent with Xray data only
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    script {
                        def managed = readJSON file: 'report/managed-dependencies.json', returnPojo: true
                        def chunks  = chunk(managed, env.CATALOG_CHUNK as int)
                        def catalog = [:]
                        withCredentials([string(credentialsId: 'jfrog-access-token', variable: 'JF_TOKEN')]) {
                            for (int i = 0; i < chunks.size(); i++) {
                                writeJSON file: "tmp/catalog-req-${i}.json", json: [query: catalogQuery(chunks[i])]
                                sh """
                                    curl -sS --fail-with-body -X POST \\
                                      -H "Authorization: Bearer \$JF_TOKEN" \\
                                      -H 'Content-Type: application/json' \\
                                      --data @tmp/catalog-req-${i}.json \\
                                      -o tmp/catalog-resp-${i}.json \\
                                      "\$JFROG_URL\$CATALOG_PATH"
                                """
                                def resp = readJSON file: "tmp/catalog-resp-${i}.json", returnPojo: true
                                def warn = graphqlErrors(resp)
                                if (warn) echo "Catalog warnings (chunk ${i}): ${warn}"
                                mergeCatalog(catalog, chunks[i], resp)
                            }
                        }
                        writeJSON file: 'report/catalog.json', json: catalog, pretty: 2
                        echo "Catalog: ${catalog.size()} vulnerable components"
                    }
                }
            }
        }

        stage('Build report') {
            steps {
                script {
                    def managed   = readJSON file: 'report/managed-dependencies.json', returnPojo: true
                    def xray      = readJSON file: 'report/xray.json', returnPojo: true
                    def catalogOk = fileExists('report/catalog.json')
                    def catalog   = catalogOk ? readJSON(file: 'report/catalog.json', returnPojo: true) : [:]

                    def findings = buildFindings(managed, xray, catalog, params.MIN_SEVERITY)
                    writeJSON file: 'report/findings.json', json: findings, pretty: 2
                    writeFile file: 'report/cve-report.csv',  text: toCsv(findings)
                    // full report (archived, linked from the mail button) + truncated digest for the mail body
                    writeFile file: 'report/cve-report.html',
                              text: toHtml(findings, env.BOOTSTRAP_GAV, env.BUILD_URL, managed.size(), catalogOk, params.MIN_SEVERITY, 0)
                    writeFile file: 'report/mail.html',
                              text: toHtml(findings, env.BOOTSTRAP_GAV, env.BUILD_URL, managed.size(), catalogOk, params.MIN_SEVERITY, 20)

                    env.VULN_DEPS = "${findings.size()}"
                    env.CVE_COUNT = "${cveCount(findings)}"
                    currentBuild.description = "${env.VULN_DEPS} vulnerable deps / ${env.CVE_COUNT} CVEs"
                }
            }
        }

        stage('Send mail') {
            when { expression { (env.VULN_DEPS as int) > 0 || params.MAIL_WHEN_CLEAN } }
            steps {
                emailext(
                    to: params.MAIL_TO,
                    subject: "[${env.BOOTSTRAP_GAV}] Security alert digest - ${env.VULN_DEPS} vulnerable dependencies",
                    mimeType: 'text/html',
                    body: readFile('report/mail.html'),
                    attachmentsPattern: 'report/cve-report.csv'
                )
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'report/**', allowEmptyArchive: true
        }
        failure {
            emailext(
                to: params.MAIL_TO,
                subject: "[Bootstrap CVE audit] FAILED - build #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                body: "The daily bootstrap CVE audit failed. Console: <a href=\"${env.BUILD_URL}console\">${env.BUILD_URL}console</a>"
            )
        }
    }
}

// ───────────────────────────── helpers (executed outside CPS) ─────────────────────────────

@NonCPS
List extractManaged(model) {
    def seen = [:]
    (model.dependencyManagement?.dependencies ?: []).each { d ->
        if (d.version && !d.version.contains('${')) {
            seen["${d.groupId}:${d.artifactId}:${d.version}".toString()] = [g: d.groupId, a: d.artifactId, v: d.version]
        }
    }
    return seen.values().toList().sort { it.g + ':' + it.a }
}

@NonCPS
List chunk(List items, int size) {
    def out = []
    for (int i = 0; i < items.size(); i += size) {
        out << items.subList(i, Math.min(i + size, items.size())).collect { it }   // copy: subList is not serializable
    }
    return out
}

@NonCPS
Map xrayBody(List chunk) {
    return [component_details: chunk.collect { [component_id: "gav://${it.g}:${it.a}:${it.v}".toString()] }]
}

@NonCPS
void mergeXray(Map acc, Map resp) {
    (resp?.artifacts ?: []).each { art ->
        String id = (art?.general?.component_id ?: '').toString().replaceFirst('^gav://', '')
        if (!id) return
        (art.issues ?: []).each { issue ->
            if (issue.issue_type && issue.issue_type != 'security') return
            List fixed = (issue.components ?: [])
                    .collectMany { (it.fixed_versions ?: []) as List }
                    .collect { cleanVersion(it?.toString()) }
                    .findAll { it }.unique()
            List cves = (issue.cves ?: []).collect { it.cve }.findAll { it }
            if (!cves) cves = [issue.issue_id]
            cves.each { cve ->
                if (!acc.containsKey(id)) acc[id] = [:]
                if (!acc[id].containsKey(cve)) acc[id][cve] = [fixed: []]
                Map e = acc[id][cve]
                e.xrayId   = issue.issue_id
                e.severity = issue.severity
                e.summary  = issue.summary
                def raw = (issue.cves ?: []).find { it.cve == cve }?.cvss_v3      // e.g. "9.8/CVSS:3.1/AV:N/..."
                def score = raw ? raw.toString().tokenize('/')[0] : null
                if (score && score.isNumber()) e.cvss = score.toDouble()
                e.fixed = (e.fixed + fixed).unique()
            }
        }
    }
}

@NonCPS
String cleanVersion(String raw) {
    if (!raw) return null
    // Xray returns "[2.17.1]" or ranges like "[2.12.2,2.13.0)": keep the lower bound
    return raw.replaceAll(/[\[\]\(\)\s]/, '').tokenize(',').find { it }
}

@NonCPS
String catalogQuery(List chunk) {
    def parts = []
    for (int i = 0; i < chunk.size(); i++) {
        def d = chunk[i]
        parts << """p${i}: packageVersion(type: "maven", name: "${d.g}:${d.a}", version: "${d.v}") {
  vulnerabilities(first: 100, orderBy: {field: SEVERITY, direction: DESC}) {
    edges { node { name severity cvss { preferredBaseScore } knownExploit { dateAdded } } }
  }
}"""
    }
    return 'query {\n' + parts.join('\n') + '\n}'
}

@NonCPS
String graphqlErrors(Map resp) {
    return (resp?.errors ?: []).collect { it.message }.unique().take(5).join(' | ')
}

@NonCPS
void mergeCatalog(Map acc, List chunk, Map resp) {
    def data = resp?.data ?: [:]
    for (int i = 0; i < chunk.size(); i++) {
        def d  = chunk[i]
        def pv = data["p${i}".toString()]
        if (!pv) continue
        String gav = "${d.g}:${d.a}:${d.v}"
        (pv.vulnerabilities?.edges ?: []).each { edge ->
            def n = edge.node
            if (!n?.name) return
            if (!acc.containsKey(gav)) acc[gav] = [:]
            acc[gav][n.name] = [
                severity: n.severity,
                cvss    : n.cvss?.preferredBaseScore != null ? (n.cvss.preferredBaseScore as double) : null,
                exploit : n.knownExploit != null
            ]
        }
    }
}

@NonCPS
String normSev(s) {
    String v = (s ?: 'UNKNOWN').toString().toUpperCase()
    return ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'].contains(v) ? v : 'UNKNOWN'
}

@NonCPS
List buildFindings(List managed, Map xray, Map catalog, String minSeverity) {
    def rank = [UNKNOWN: 0, LOW: 1, MEDIUM: 2, HIGH: 3, CRITICAL: 4]
    int min = rank[minSeverity.toUpperCase()] ?: 0
    def out = []
    managed.each { d ->
        String gav = "${d.g}:${d.a}:${d.v}"
        Map x = xray[gav] ?: [:]
        Map c = catalog[gav] ?: [:]
        def cves = []
        (x.keySet() + c.keySet()).each { id ->
            Map xi = x[id] ?: [:]
            Map ci = c[id] ?: [:]
            String sev = [normSev(xi.severity), normSev(ci.severity)].max { rank[it] }
            if (rank[sev] < min) return
            List fixed = (xi.fixed ?: []).findAll { compareVersions(it, d.v) > 0 }
                                          .sort { a, b -> compareVersions(a, b) }
            def scores = [xi.cvss, ci.cvss].findAll { it != null }.collect { it as double }
            cves << [
                id      : id,
                severity: sev,
                cvss    : scores ? scores.max() : null,
                exploit : ci.exploit ?: false,
                fixedIn : fixed.join(', '),
                bestFix : pickFix(d.v, fixed),
                summary : xi.summary ?: '',
                source  : [xi ? 'Xray' : null, ci ? 'Catalog' : null].findAll { it }.join('+')
            ]
        }
        if (cves) {
            cves.sort { a, b -> (rank[b.severity] <=> rank[a.severity]) ?: ((b.cvss ?: 0d) <=> (a.cvss ?: 0d)) }
            def known = cves.collect { it.bestFix }.findAll { it }
            out << [
                group      : d.g,
                artifact   : d.a,
                version    : d.v,
                maxSeverity: cves[0].severity,
                recommended: known ? known.max { a, b -> compareVersions(a, b) } : null,
                unfixed    : cves.any { !it.bestFix },
                cves       : cves
            ]
        }
    }
    out.sort { a, b -> (rank[b.maxSeverity] <=> rank[a.maxSeverity]) ?: (b.cves.size() <=> a.cves.size()) }
    return out
}

/** Smallest fixed version, preferring the same major.minor line, then the same major. */
@NonCPS
String pickFix(String current, List fixedSortedAsc) {
    if (!fixedSortedAsc) return null
    List cur = current.tokenize('.-')
    def sameMinor = fixedSortedAsc.find { it.tokenize('.-').take(2) == cur.take(2) }
    def sameMajor = fixedSortedAsc.find { it.tokenize('.-')[0] == cur[0] }
    return sameMinor ?: sameMajor ?: fixedSortedAsc[0]
}

/** Maven-like version comparison: 1.0-RC1 < 1.0 = 1.0.Final < 1.0-SP1 < 1.0.1 */
@NonCPS
int compareVersions(String a, String b) {
    List ta = versionTokens(a), tb = versionTokens(b)
    int n = Math.max(ta.size(), tb.size())
    for (int i = 0; i < n; i++) {
        List x = i < ta.size() ? ta[i] : [2, 0L]
        List y = i < tb.size() ? tb[i] : [2, 0L]
        int c = (x[0] <=> y[0]) ?: (x[1] <=> y[1])
        if (c != 0) return c
    }
    return 0
}

@NonCPS
List versionTokens(String v) {
    def preRelease = [alpha: 1L, a: 1L, beta: 2L, b: 2L, milestone: 3L, m: 3L, rc: 4L, cr: 4L, snapshot: 5L]
    def release    = ['ga', 'final', 'release', 'sp']
    return (v ?: '').toLowerCase()
            .split(/[.\-_+]|(?<=\d)(?=\D)|(?<=\D)(?=\d)/)
            .findAll { it }
            .collect { t ->
                if (t ==~ /\d{1,18}/)     return [2, t.toLong()]
                if (release.contains(t))  return [2, 0L]
                return [1, preRelease.containsKey(t) ? preRelease[t] : 6L]
            }
}

@NonCPS
int cveCount(List findings) {
    int total = 0
    findings.each { total += it.cves.size() }
    return total
}

@NonCPS
String esc(Object s) {
    return (s == null ? '' : s.toString())
            .replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')
}

@NonCPS
String toCsv(List findings) {
    def q = { v -> '"' + (v == null ? '' : v.toString().replace('"', '""')) + '"' }
    def lines = ['groupId;artifactId;currentVersion;cve;severity;cvss;knownExploit;fixedIn;recommendedVersion;source']
    findings.each { f ->
        f.cves.each { c ->
            lines << [f.group, f.artifact, f.version, c.id, c.severity, c.cvss, c.exploit,
                      c.fixedIn, f.recommended, c.source].collect(q).join(';')
        }
    }
    return lines.join('\n') + '\n'
}

/**
 * Mail rendered in the style of a "Security alert digest":
 * one card per vulnerable dependency (Dependency / Version / Upgrade to / Vulnerabilities),
 * outlined severity labels and a green call-to-action button.
 * maxDeps = 0 renders every dependency (archived report), > 0 truncates (mail).
 */
@NonCPS
String toHtml(List findings, String bootstrap, String buildUrl, int managedCount, boolean catalogOk, String minSeverity, int maxDeps = 0) {
    final int MAX_CVES_PER_DEP = 5
    String font = "-apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans',Helvetica,Arial,sans-serif"
    String mono = "ui-monospace,SFMono-Regular,'SF Mono',Menlo,Consolas,monospace"
    String reportUrl = buildUrl ? "${buildUrl}artifact/report/cve-report.html" : '#'
    String bootstrapName = (bootstrap ?: '').tokenize(':').size() > 1 ? bootstrap.tokenize(':')[1] : bootstrap

    def sev = [CRITICAL: ['Critical', '#cf222e'], HIGH: ['High', '#bc4c00'], MEDIUM: ['Moderate', '#9a6700'],
               LOW: ['Low', '#57606a'], UNKNOWN: ['Unknown', '#57606a']]
    def label = { String s ->
        def st = sev[s] ?: sev.UNKNOWN
        "<span style=\"display:inline-block;padding:0 7px;font-size:12px;font-weight:500;line-height:18px;" +
        "border:1px solid ${st[1]};border-radius:2em;color:${st[1]};white-space:nowrap\">${st[0]}</span>"
    }
    def code = { String v, String bg, String fg ->
        "<code style=\"font-family:${mono};font-size:12px;padding:2px 6px;border-radius:6px;background:${bg};color:${fg}\">${esc(v)}</code>"
    }
    def keyCell = 'style="padding:4px 16px 4px 0;width:120px;color:#57606a;font-size:14px;vertical-align:top;white-space:nowrap"'
    def valCell = 'style="padding:4px 0;font-size:14px;color:#1f2328;vertical-align:top"'

    def counts = [CRITICAL: 0, HIGH: 0, MEDIUM: 0, LOW: 0, UNKNOWN: 0]
    findings.each { f -> f.cves.each { counts[it.severity] = counts[it.severity] + 1 } }
    int total = counts.values().sum() as int
    List shown = (maxDeps > 0 && findings.size() > maxDeps) ? findings.take(maxDeps) : findings

    def h = []
    // ── page + container ───────────────────────────────────────────────────────
    h << "<html><body style=\"margin:0;padding:0;background:#f6f8fa;font-family:${font};color:#1f2328\">"
    h << '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f8fa"><tr><td align="center" style="padding:32px 12px">'
    h << '<table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%">'

    // ── header ─────────────────────────────────────────────────────────────────
    h << '<tr><td style="padding:0 0 16px;font-size:14px;color:#57606a">&#128737;&nbsp; <b style="color:#1f2328">Platform Security</b></td></tr>'
    h << '<tr><td style="padding:0 0 8px;font-size:24px;font-weight:400;color:#1f2328">Security alert digest</td></tr>'
    h << "<tr><td style=\"padding:0 0 24px;font-size:14px;line-height:1.5;color:#1f2328\">"
    h << (findings ? "Known security vulnerabilities detected in dependencies managed by <b>${esc(bootstrapName)}</b>." :
                     "No known security vulnerability in dependencies managed by <b>${esc(bootstrapName)}</b>.")
    h << '</td></tr>'

    // ── warning when Catalog failed ────────────────────────────────────────────
    if (!catalogOk) {
        h << '<tr><td style="padding:0 0 16px"><div style="padding:12px 16px;background:#fff8c5;border:1px solid #d4a72c;border-radius:6px;font-size:13px">' +
             '&#9888;&nbsp; JFrog Catalog was unavailable: results are based on JFrog Xray only.</div></td></tr>'
    }

    // ── repository-like card ───────────────────────────────────────────────────
    h << '<tr><td style="background:#ffffff;border:1px solid #d0d7de;border-radius:6px">'
    h << '<table role="presentation" width="100%" cellpadding="0" cellspacing="0">'

    // card header: bootstrap GAV + counters
    h << '<tr><td style="padding:16px 24px;background:#f6f8fa;border-bottom:1px solid #d0d7de;border-radius:6px 6px 0 0">'
    h << "<div style=\"font-size:14px;font-weight:600\"><a href=\"${esc(buildUrl)}\" style=\"color:#0969da;text-decoration:none\">${esc(bootstrap)}</a></div>"
    h << "<div style=\"padding-top:6px;font-size:12px;color:#57606a\">${findings.size()} vulnerable ${findings.size() == 1 ? 'dependency' : 'dependencies'} &middot; ${total} ${total == 1 ? 'vulnerability' : 'vulnerabilities'} &middot; ${managedCount} managed dependencies analysed</div>"
    if (total > 0) {
        h << '<div style="padding-top:10px">' +
             counts.findAll { k, v -> v > 0 }.collect { k, v -> "${label(k)}&nbsp;<span style=\"font-size:12px;color:#57606a\">${v}</span>" }.join('&nbsp;&nbsp;&nbsp;') +
             '</div>'
    }
    h << '</td></tr>'

    if (!findings) {
        h << '<tr><td style="padding:24px;font-size:14px;color:#1a7f37">&#10004;&nbsp; All dependencies are free of known vulnerabilities' +
             (minSeverity && minSeverity != 'Low' ? " (severity &ge; ${esc(minSeverity)})" : '') + '.</td></tr>'
    }

    // one block per vulnerable dependency
    shown.eachWithIndex { f, idx ->
        String border = idx == 0 ? '' : 'border-top:1px solid #d0d7de;'
        h << "<tr><td style=\"padding:16px 24px;${border}\">"
        h << '<table role="presentation" width="100%" cellpadding="0" cellspacing="0">'

        h << "<tr><td ${keyCell}>Dependency</td><td ${valCell}><b>${esc(f.artifact)}</b> " +
             "<span style=\"color:#57606a;font-size:12px\">${esc(f.group)}</span>&nbsp;&nbsp;${label(f.maxSeverity)}</td></tr>"

        h << "<tr><td ${keyCell}>Version</td><td ${valCell}>${code(f.version, '#ffebe9', '#82071e')}</td></tr>"

        String upgrade
        if (f.recommended) {
            upgrade = code("${f.recommended}", '#dafbe1', '#116329')
            if (f.unfixed) upgrade += '<br><span style="font-size:12px;color:#cf222e">Some vulnerabilities have no patched version yet</span>'
        } else {
            upgrade = '<span style="font-size:13px;color:#cf222e">No patched version available</span>'
        }
        h << "<tr><td ${keyCell}>Upgrade to</td><td ${valCell}>${upgrade}</td></tr>"

        def vulns = f.cves.take(MAX_CVES_PER_DEP).collect { c ->
            String id = c.id.toString()
            String link = id.startsWith('CVE-') ?
                    "<a href=\"https://nvd.nist.gov/vuln/detail/${esc(id)}\" style=\"color:#0969da;text-decoration:none\">${esc(id)}</a>" : esc(id)
            def extras = []
            if (c.cvss != null) extras << "CVSS ${c.cvss}"
            if (c.fixedIn)      extras << "fixed in ${esc(c.fixedIn)}"
            String line = "${label(c.severity)}&nbsp; ${link}" +
                          (extras ? " <span style=\"font-size:12px;color:#57606a\">&middot; ${extras.join(' &middot; ')}</span>" : '') +
                          (c.exploit ? ' <span style="font-size:12px;font-weight:600;color:#cf222e">&middot; known exploit</span>' : '')
            String summary = c.summary ? c.summary.toString() : ''
            if (summary.size() > 140) summary = summary.take(140) + '&hellip;'
            "<div style=\"padding:3px 0\">${line}" +
            (summary ? "<div style=\"font-size:12px;color:#57606a;padding:2px 0 0\">${esc(summary).replace('&amp;hellip;', '&hellip;')}</div>" : '') +
            '</div>'
        }
        if (f.cves.size() > MAX_CVES_PER_DEP) {
            vulns << "<div style=\"padding:3px 0;font-size:12px;color:#57606a\">+ ${f.cves.size() - MAX_CVES_PER_DEP} more</div>"
        }
        h << "<tr><td ${keyCell}>Vulnerabilities</td><td ${valCell}>${vulns.join('')}</td></tr>"

        h << '</table></td></tr>'
    }

    if (shown.size() < findings.size()) {
        h << "<tr><td style=\"padding:12px 24px;border-top:1px solid #d0d7de;font-size:13px;color:#57606a\">" +
             "and ${findings.size() - shown.size()} more vulnerable dependencies&hellip;</td></tr>"
    }
    h << '</table></td></tr>'

    // ── call to action ─────────────────────────────────────────────────────────
    if (findings) {
        h << "<tr><td align=\"center\" style=\"padding:24px 0 8px\">" +
             "<a href=\"${esc(reportUrl)}\" style=\"display:inline-block;padding:8px 16px;background:#1f883d;color:#ffffff;" +
             "font-size:14px;font-weight:600;text-decoration:none;border-radius:6px;border:1px solid #1a7f37\">Review all vulnerable dependencies</a></td></tr>"
    }

    // ── footer ─────────────────────────────────────────────────────────────────
    h << "<tr><td style=\"padding:24px 0 0;font-size:12px;line-height:1.5;color:#57606a;border-top:1px solid #d0d7de\">" +
         "You are receiving this digest because you are subscribed to the daily security audit of <b>${esc(bootstrapName)}</b>. " +
         "Data from JFrog Xray${catalogOk ? ' and JFrog Catalog' : ''} &middot; minimum severity: ${esc(minSeverity)} &middot; full list attached as CSV.<br>" +
         "<a href=\"${esc(buildUrl)}\" style=\"color:#0969da;text-decoration:none\">View the Jenkins build</a></td></tr>"

    h << '</table></td></tr></table></body></html>'
    return h.join('\n')
}
